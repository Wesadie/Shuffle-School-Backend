# ShuffleSchool environment variables
#
# NEVER commit real credentials to this repository.
# Production values belong in your host's environment settings (e.g. Render).
# For local development, copy this file to .env.local (git-ignored) and fill in
# SANDBOX values only.

# --- Database ---
DATABASE_URL=

# --- Public HTTPS base URL ---
# Used to build the PayFast return_url / cancel_url / notify_url.
# Production: https://shuffleschool.co.za
# Local sandbox testing: your tunnel HTTPS origin (PayFast requires HTTPS).
APP_BASE_URL=

# --- PayFast (server-side only — never expose these to the client) ---
# Live credentials come from your PayFast merchant dashboard.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Passphrase configured in PayFast Settings (used for signature generation/verification).
PAYFAST_PASSPHRASE=
# "true" = sandbox (sandbox.payfast.co.za). Unset/"false" = live (www.payfast.co.za).
PAYFAST_SANDBOX=false
